{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "app.py": {
      "excludeFiles": "{data/**,work/**,.venv/**,venv/**,__pycache__/**,**/__pycache__/**,tests/**,.env*}",
      "includeFiles": "{public/**,image_permissions.sql,read_models.sql}"
    }
  },
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/",
      "destination": "/index.html"
    }
  ]
}
